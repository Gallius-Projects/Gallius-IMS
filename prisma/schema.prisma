generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum status {
  SPARE
  DEPLOYED
  DEFECTIVE
  DONATED
  DISPOSED
}

model sidebarLinks {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  path             String             @unique
  icon             String
  createdAt        DateTime           @default(now())
  sidebarLinkRoles sidebarLinkRoles[]
  accounts         accounts?          @relation(fields: [accountsUuid], references: [uuid])
  accountsUuid     String?
  adminLogs        adminLogs[]
}

model sidebarLinkRoles {
  id            Int      @id @default(autoincrement())
  sidebarLinkId Int
  roleId        Int
  createdAt     DateTime @default(now())

  sidebarLink sidebarLinks @relation(fields: [sidebarLinkId], references: [id], onDelete: Cascade)
  role        roles        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([sidebarLinkId, roleId])
}

model roles {
  id        Int      @id @default(autoincrement())
  role      String   @unique
  createdAt DateTime @default(now())

  sidebarLinkRoles sidebarLinkRoles[]
  accounts         accounts[]
  accountLogs      accountLogs[]
}

model departments {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  abbreviation String?
  createdAt    DateTime      @default(now())
  positions    positions[]
  employees    employees[]
  accountLogs  accountLogs[]
}

model positions {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  departmentId Int
  department   departments   @relation(fields: [departmentId], references: [id])
  createdAt    DateTime      @default(now())
  employees    employees[]
  accountLogs  accountLogs[]
}

model accounts {
  uuid                   String          @id @default(uuid())
  username               String          @unique
  passwordHash           String
  role                   roles?          @relation(fields: [roleId], references: [id])
  roleId                 Int?
  status                 Boolean         @default(true)
  createdAt              DateTime        @default(now())
  employeeId             Int             @unique
  employee               employees       @relation(fields: [employeeId], references: [id])
  sidebarLinks           sidebarLinks[]
  inventoryLogs          inventoryLogs[]
  adminLogs              adminLogs[]
  accountsUpdated        accountLogs[]   @relation("updatedAccount")
  accountsUserIsInvolved accountLogs[]   @relation("involvedUser")
}

model categories {
  id             Int              @id @default(autoincrement())
  name           String
  quantity       Int?
  abbreviation   String?
  createdAt      DateTime         @default(now())
  inventoryItems inventoryItems[]
  adminLogs      adminLogs[]
}

model brands {
  id             Int              @id @default(autoincrement())
  name           String
  createdAt      DateTime         @default(now())
  inventoryItems inventoryItems[]
  adminLogs      adminLogs[]
}

model suppliers {
  id             Int              @id @default(autoincrement())
  name           String
  contactPerson  String?
  contactNumber  String?
  email          String?
  address        String?
  createdAt      DateTime         @default(now())
  inventoryItems inventoryItems[]
  adminLogs      adminLogs[]
}

model locations {
  id             Int              @id @default(autoincrement())
  name           String
  abbreviation   String?
  createdAt      DateTime         @default(now())
  inventoryItems inventoryItems[]
  adminLogs      adminLogs[]
}

model offices {
  id             Int              @id @default(autoincrement())
  name           String
  status         Boolean          @default(true)
  abbreviation   String?
  createdAt      DateTime         @default(now())
  inventoryItems inventoryItems[]
  employees      employees[]
  adminLogs      adminLogs[]
}

model inventoryItems {
  id             Int             @id @default(autoincrement())
  name           String
  oldAssetTag    String?
  newAssetTag    String?
  serialNumber   String?
  description    String?         @db.Text
  hostname       String?         @unique
  status         status
  categoryId     Int
  category       categories      @relation(fields: [categoryId], references: [id])
  locationId     Int
  location       locations       @relation(fields: [locationId], references: [id])
  brandId        Int
  brand          brands          @relation(fields: [brandId], references: [id])
  assignedTo     Int?
  assignedEmp    employees?      @relation("assignedEmp", fields: [assignedTo], references: [id])
  officeId       Int
  office         offices         @relation(fields: [officeId], references: [id])
  deployedById   Int?
  deployedBy     employees?      @relation("deployedBy", fields: [deployedById], references: [id])
  invoiceNo      String?
  dateDeployed   DateTime?
  datePurchased  DateTime?
  assetCondition String?
  isNew          Boolean         @default(true)
  remarks        String          @db.Text
  createdAt      DateTime        @default(now())
  supplier       suppliers?      @relation(fields: [supplierId], references: [id])
  supplierId     Int?
  inventoryLogs  inventoryLogs[]
}

model employees {
  id            Int              @id @default(autoincrement())
  employeeId    String?          @unique
  firstName     String
  lastName      String
  middleName    String?
  suffix        String?
  office        offices?         @relation(fields: [officeId], references: [id])
  officeId      Int?
  department    departments      @relation(fields: [departmentId], references: [id])
  departmentId  Int
  position      positions        @relation(fields: [positionId], references: [id])
  positionId    Int
  status        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  accounts      accounts?
  assignedItems inventoryItems[] @relation("assignedEmp")
  itemsDeployed inventoryItems[] @relation("deployedBy")
  adminLogs     adminLogs[]
  accountLogs   accountLogs[]
}

model inventoryLogs {
  id               Int             @id @default(autoincrement())
  activity         String          @db.Text
  updatedItem      inventoryItems? @relation(fields: [inventoryId], references: [id])
  inventoryId      Int?
  involvedUserUUID String?
  involvedUser     accounts?       @relation(fields: [involvedUserUUID], references: [uuid])
  updatedAt        DateTime        @updatedAt
}

model adminLogs {
  id                   Int           @id @default(autoincrement())
  activity             String        @db.Text
  updatedOfficeId      Int?
  updatedOffice        offices?      @relation(fields: [updatedOfficeId], references: [id])
  updatedCategoryId    Int?
  updatedCategory      categories?   @relation(fields: [updatedCategoryId], references: [id])
  updatedBrandId       Int?
  updatedBrand         brands?       @relation(fields: [updatedBrandId], references: [id])
  updatedSupplierId    Int?
  updatedSupplier      suppliers?    @relation(fields: [updatedSupplierId], references: [id])
  updatedLocationId    Int?
  updatedLocation      locations?    @relation(fields: [updatedLocationId], references: [id])
  updatedSidebarLinkId Int?
  updatedSidebarLink   sidebarLinks? @relation(fields: [updatedSidebarLinkId], references: [id])
  involvedUserUUID     String?
  involvedUser         accounts?     @relation(fields: [involvedUserUUID], references: [uuid])
  updatedAt            DateTime      @updatedAt
  employees            employees?    @relation(fields: [employeesId], references: [id])
  employeesId          Int?
}

model accountLogs {
  id                  Int          @id @default(autoincrement())
  activity            String       @db.Text
  updatedPositionId   Int?
  updatedPosition     positions?   @relation(fields: [updatedPositionId], references: [id])
  updatedDepartmentId Int?
  updatedDepartment   departments? @relation(fields: [updatedDepartmentId], references: [id])
  updatedEmployeeId   Int?
  updatedEmployee     employees?   @relation(fields: [updatedEmployeeId], references: [id])
  updatedAccountUuid  String?
  updatedAccount      accounts?    @relation("updatedAccount", fields: [updatedAccountUuid], references: [uuid])
  updatedRoleId       Int?
  updatedRole         roles?       @relation(fields: [updatedRoleId], references: [id])
  involvedUserUUID    String?
  involvedUser        accounts?    @relation("involvedUser", fields: [involvedUserUUID], references: [uuid])
  updatedAt           DateTime     @updatedAt
}
